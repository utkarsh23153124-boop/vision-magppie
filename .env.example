# Maggpie Central Environment Configuration Template
# ==================================================

# Admin UI access password (must be at least 16 characters)
MAGGPIE_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_PASSWORD_16_CHARS

# Fernet encryption key used to encrypt employee face embeddings in SQLite
# Generate via: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MAGGPIE_STAFF_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Dashboard origin URL (exact scheme/host/port, no trailing slash)
MAGGPIE_PUBLIC_ORIGIN=http://127.0.0.1:8010

# Directory where SQLite databases and logs are stored
MAGGPIE_DATA_DIR=data

# Maximum concurrent camera workers running simultaneously
MAGGPIE_MAX_CAMERAS=4

# Authorized RTSP/HTTP camera stream secrets
# Format: MAGGPIE_CAMERA_<NAME>=rtsp://user:pass@ip:554/stream
MAGGPIE_CAMERA_TEST=0
