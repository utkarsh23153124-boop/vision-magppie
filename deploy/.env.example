# Copy to deploy/.env on the chosen server. Do not commit real secrets.
MAGGPIE_DOMAIN=vision.example.com
MAGGPIE_ADMIN_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
# Generate using: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back up this key securely with the database. Changing it without migration breaks stored templates.
MAGGPIE_STAFF_KEY=REPLACE_WITH_GENERATED_FERNET_KEY
MAGGPIE_MAX_CAMERAS=4
# Reach cameras through a private VPN route; do not expose showroom RTSP ports publicly.
MAGGPIE_CAMERA_DELHI_ENTRY=rtsp://USERNAME:PASSWORD@PRIVATE_CAMERA_IP:554/STREAM_PATH
